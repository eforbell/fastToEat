[Unit]
Description=Forbell Fast to Eat App
After=network.target postgresql.service

[Service]
Type=simple
User=forbell
WorkingDirectory=/data/apps/fastToEat
EnvironmentFile=/data/apps/fastToEat/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /data/apps/fastToEat/server.js
Restart=always
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
